# Шаблон локальних налаштувань. `npm run dev` копіює його в .env, якщо .env ще немає.
# Реальних секретів тут немає: значення лише для локальної розробки й демо.

# SQLite-файл; відносний шлях рахується від папки server/.
DATABASE_URL="file:./prisma/dev.db"

SERVER_PORT=3000
CLIENT_PORT=5173

# Часовий пояс університету для відображення дат (G9, [Гіпотеза]).
APP_TIMEZONE="Europe/Kyiv"

# Адміністратор, якого створює seed (TA-2). Змініть пароль у своєму .env.
ADMIN_EMAIL="admin@roomly.local"
ADMIN_PASSWORD="roomly-admin-dev"
ADMIN_NAME="Адміністратор Roomly"
